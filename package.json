{
  "name": "catstar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vinext build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:assets && npm run test:motion-review",
    "test:assets": "sh scripts/run_python_with_pillow.sh scripts/test_check_cat_action_assets.py",
    "test:motion-review": "sh scripts/run_python_with_pillow.sh scripts/test_cat_motion_review.py",
    "test:e2e": "playwright test",
    "check:bundle": "python3 scripts/check_bundle_budget.py",
    "check:assets": "sh scripts/run_python_with_pillow.sh scripts/check_cat_action_assets.py",
    "check:assets:release": "sh scripts/run_python_with_pillow.sh scripts/check_cat_action_assets.py --profile first-release",
    "review:runtime": "sh scripts/run_python_with_pillow.sh scripts/capture_cat_runtime_review.py",
    "review:runtime:check": "CATSTAR_REVIEW_VALIDATE_ONLY=1 sh scripts/run_python_with_pillow.sh scripts/capture_cat_runtime_review.py",
    "review:motion": "sh scripts/run_python_with_pillow.sh scripts/capture_cat_motion_review.py",
    "review:motion:check": "sh scripts/run_python_with_pillow.sh scripts/capture_cat_motion_review.py --validate-only",
    "review:motion:check:release": "sh scripts/run_python_with_pillow.sh scripts/capture_cat_motion_review.py --validate-only --require-human-pass",
    "review:motion:record": "sh scripts/run_python_with_pillow.sh scripts/record_cat_motion_review.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.32",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "^7.0.2",
    "vinext": "^1.0.0-beta.4",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.92.0"
  }
}
