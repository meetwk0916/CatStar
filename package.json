{
  "name": "catstar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vinext build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:bundle": "python3 scripts/check_bundle_budget.py",
    "check:assets": "sh scripts/run_python_with_pillow.sh scripts/check_cat_action_assets.py",
    "review:runtime": "sh scripts/run_python_with_pillow.sh scripts/capture_cat_runtime_review.py",
    "review:runtime:check": "CATSTAR_REVIEW_VALIDATE_ONLY=1 sh scripts/run_python_with_pillow.sh scripts/capture_cat_runtime_review.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.26",
    "playwright": "1.61.1",
    "react-server-dom-webpack": "^19.2.6",
    "typescript": "^5.9.3",
    "vinext": "^1.0.0-beta.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.8",
    "wrangler": "^4.92.0"
  }
}
